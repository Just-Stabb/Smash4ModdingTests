+        /// <summary>
+        /// A workspace file whose content is the game's own (vanilla) version, byte for byte
+        /// </summary>
+        public class VanillaCopy
+        {
+            public string AbsolutePath;
+            public string WorkspaceFile;
+            public long Size;
+        }
+
+        /// <summary>
+        /// Find the workspace files identical to the game's own version (what the game loads: the update's
+        /// version if it has one, else the DT files'). Building without them gives the same result, without
+        /// rebuilding the packages they're in. Only files the game has are checked; mod-only files, folders,
+        /// files of removed resources and files without an accepted extension are left out.
+        /// </summary>
+        /// <param name="absolutePath">Only look under this path ("data/fighter/kirby/", a file, a partition "data/"); null: the whole workspace</param>
+        public List<VanillaCopy> FindVanillaCopies(string absolutePath)
+        {
+            List<VanillaCopy> copies = new List<VanillaCopy>();
+            int checkedFiles = 0, skippedLS = 0;
+            foreach (ResourceCollection resCol in _resCols)
+            {
+                string prefix = string.Empty;
+                if (absolutePath != null)
+                {
+                    if (absolutePath.Substring(0, absolutePath.IndexOf('/')) != resCol.PartitionName)
+                        continue;
+                    prefix = GetRelativePath(absolutePath);
+                }
+                foreach (string relativePath in GetAllWorkplaceRelativePaths(resCol.PartitionName))
+                {
+                    if (relativePath.EndsWith("/") || !relativePath.StartsWith(prefix))
+                        continue;
+                    ResourceItem rItem = GetResource(resCol, relativePath);
+                    if (rItem == null || rItem.IsFolder || _CurrentProject.IsResourceRemoved(resCol.PartitionName, relativePath))
+                        continue;
+                    if (rItem.Source == FileSource.LS && !_CurrentProject.DTFilesFound)
+                    {
+                        skippedLS++;
+                        continue;
+                    }
+                    string absPath = GetAbsolutePath(resCol, relativePath);
+                    string workspaceFile = GetWorkspaceFileFromPath(absPath);
+                    FileInfo info = new FileInfo(workspaceFile);
+                    if (!info.Exists)
+                        continue;
+                    checkedFiles++;
+                    if (checkedFiles % 500 == 0)
+                        LogHelper.Info(string.Format("Checked {0} files, {1} identical to the game's so far...", checkedFiles, copies.Count));
+                    //Different size: modified, no need to read anything
+                    if (info.Length != rItem.DecSize)
+                        continue;
+                    try
+                    {
+                        byte[] vanilla = _RfManager.GetVanillaData(rItem);
+                        if (vanilla == null || vanilla.LongLength != info.Length)
+                            continue;
+                        if (SameBytes(File.ReadAllBytes(workspaceFile), vanilla))
+                            copies.Add(new VanillaCopy() { AbsolutePath = absPath, WorkspaceFile = workspaceFile, Size = info.Length });
+                    }
+                    catch (Exception e)
+                    {
+                        LogHelper.Warning(string.Format("Can't compare '{0}' with the game's version ({1}), keeping it", absPath, e.Message));
+                    }
+                }
+                _RfManager.ClearCachedDataSources();
+            }
+            if (skippedLS > 0)
+                LogHelper.Warning(string.Format("{0} files could not be checked: the DT files were not found", skippedLS));
+            LogHelper.Info(string.Format("Checked {0} workspace files: {1} identical to the game's version ({2:0.0} MB)", checkedFiles, copies.Count, copies.Sum(c => c.Size) / 1048576.0));
+            return copies;
+        }
+
+        /// <summary>
+        /// Move files found by FindVanillaCopies out of the workspace, to backupFolder (the same paths under it),
+        /// then delete the workspace folders they leave empty. The plugins are asked first, as for "Remove mod files".
+        /// </summary>
+        /// <returns>The number of files moved</returns>
+        public int RemoveVanillaCopies(List<VanillaCopy> copies, string backupFolder)
+        {
+            int moved = 0;
+            HashSet<string> folders = new HashSet<string>();
+            foreach (VanillaCopy copy in copies)
+            {
+                ResourceCollection resCol = GetResourceCollection(copy.AbsolutePath);
+                string relativePath = GetRelativePath(copy.AbsolutePath);
+                bool cancel = false;
+                foreach (Sm4shBasePlugin plugin in _Plugins)
+                {
+                    PluginActionResult result = plugin.InternalResourcesRemovingFromWorkspace(resCol, relativePath, copy.WorkspaceFile);
+                    if (result.Cancel)
+                    {
+                        LogHelper.Warning(string.Format("Keeping '{0}', reason: {1}", copy.AbsolutePath, result.Reason));
+                        cancel = true;
+                        break;
+                    }
+                }
+                if (cancel)
+                    continue;
+                try
+                {
+                    string target = backupFolder + copy.AbsolutePath.Replace('/', Path.DirectorySeparatorChar);
+                    Directory.CreateDirectory(Path.GetDirectoryName(target));
+                    if (File.Exists(target))
+                        File.Delete(target);
+                    File.Move(copy.WorkspaceFile, target);
+                    folders.Add(Path.GetDirectoryName(copy.WorkspaceFile));
+                    moved++;
+                }
+                catch (Exception e)
+                {
+                    LogHelper.Error(string.Format("Error while moving '{0}': {1}", copy.WorkspaceFile, e.Message));
+                    continue;
+                }
+                foreach (Sm4shBasePlugin plugin in _Plugins)
+                    plugin.InternalResourcesRemovedFromWorkspace(resCol, relativePath, copy.WorkspaceFile);
+            }
+
+            //Folders left empty, deepest first, up to the partition folder
+            string root = PathHelper.GetWorkplaceFolder(PathHelperEnum.FOLDER_PATCH);
+            foreach (string folder in folders.OrderByDescending(f => f.Length))
+            {
+                string dir = folder;
+                while (dir != null && dir.Length > root.Length && dir.StartsWith(root) && dir.Substring(root.Length).IndexOf(Path.DirectorySeparatorChar) > 0
+                    && Directory.Exists(dir) && !Directory.EnumerateFileSystemEntries(dir).Any())
+                {
+                    Directory.Delete(dir);
+                    dir = Path.GetDirectoryName(dir);
+                }
+            }
+
+            LogHelper.Info(string.Format("Moved {0} files identical to the game's version to '{1}'", moved, backupFolder));
+            return moved;
+        }
+
+        private static bool SameBytes(byte[] a, byte[] b)
+        {
+            if (a.Length != b.Length)
+                return false;
+            for (int i = 0; i < a.Length; i++)
+                if (a[i] != b[i])
+                    return false;
+            return true;
+        }
         #endregion
 
