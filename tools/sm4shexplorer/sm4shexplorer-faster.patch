+        /// <summary>
+        /// A file in the patch's packed file, decompressed
+        /// </summary>
+        private byte[] ReadFromPatchPacked(ResourceItem rItem)
+        {
+            DataSource packedSource;
+            TryGetPatchPackedSource(rItem, out packedSource);
+
+            byte[] checkCmp = packedSource.Slice((int)rItem.OffInPack, 4);
+            if (checkCmp[0] == 0x78 && checkCmp[1] == 0x9c)
+                return Utils.DeCompress(packedSource.Slice((int)rItem.OffInPack, (int)rItem.CmpSize));
+            return packedSource.Slice((int)rItem.OffInPack, (int)rItem.DecSize);
+        }
+
+        /// <summary>
+        /// The game's own data of a file, as extraction writes it (decompressed), without writing it anywhere
+        /// </summary>
+        /// <returns>null if it can't be read (no LS information, missing packed file, a folder)</returns>
+        public byte[] GetVanillaData(ResourceItem rItem)
+        {
+            if (rItem.IsFolder)
+                return null;
+            switch (rItem.Source)
+            {
+                case FileSource.LS:
+                    if (rItem.LSEntryInfo == null)
+                        return null;
+                    if (rItem.CmpSize == 0)
+                        return new byte[0];
+                    return GetFileDataDecompressed(rItem.LSEntryInfo.DTOffset + rItem.OffInPack, rItem.CmpSize, rItem.LSEntryInfo.DTIndex);
+                case FileSource.Patch:
+                    string gameFile = PathHelper.GetGameFolder(PathHelperEnum.FOLDER_PATCH) + rItem.PatchItem.AbsolutePath.Replace('/', Path.DirectorySeparatorChar);
+                    if (File.Exists(gameFile))
+                    {
+                        byte[] fileBinary = File.ReadAllBytes(gameFile);
+                        if (rItem.OverridePackedFile && Utils.IsCompressed(fileBinary))
+                            fileBinary = Utils.DeCompress(fileBinary);
+                        return fileBinary;
+                    }
+                    if (!File.Exists(GetPatchPackedPath(rItem)))
+                        return null;
+                    return ReadFromPatchPacked(rItem);
+            }
