+        private void SavePackageCache(PackageProcessor package, string key, string packedPath, List<string> resPaths)
+        {
+            string folder = PackageCacheFolder;
+            string tmp = folder + key + "." + Guid.NewGuid().ToString("N") + ".tmp";
+            try
+            {
+                Directory.CreateDirectory(folder);
+                ResourceCollection resCol = package.TopResource.ResourceCollection;
+                StringBuilder meta = new StringBuilder();
+                foreach (string resPath in resPaths)
+                {
+                    ResourceItem r = resCol.Resources[resPath];
+                    meta.Append(resPath).Append('\t').Append(r.OffInPack).Append('\t').Append(r.CmpSize).Append('\t')
+                        .Append(r.DecSize).Append('\t').Append(r.IsAPackage ? 1 : 0).Append('\n');
+                }
+                File.Copy(packedPath, tmp, true);
+                File.WriteAllText(folder + key + ".meta", meta.ToString());
+                if (File.Exists(folder + key + ".packed"))
+                    File.Delete(folder + key + ".packed");
+                File.Move(tmp, folder + key + ".packed");
+            }
+            catch (Exception e)
+            {
+                LogHelper.Debug(string.Format("Couldn't cache '{0}': {1}", package.PackedAbsolutePath, e.Message));
+                try
+                {
+                    if (File.Exists(tmp))
+                        File.Delete(tmp);
+                }
+                catch (IOException) { }
+                catch (UnauthorizedAccessException) { }
+            }
+        }
