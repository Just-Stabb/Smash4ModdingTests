From 9345a19b6075362d40553f864c92cf7966f1a1d3 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 22 Oct 2026 07:51:50 +0000
Subject: [PATCH 5/5] New files inside a packaged folder go in the package

A file the game doesn't have, in a folder the game reads as one package (e.g. a new character's
ui/replace/chr/chr_10 icon), kept offset 0, which made it a package of its own: it was written as a
loose file inside the packaged folder unless the folder was set to "Pack this folder", and the game
crashed reading the package. It now goes in the package, as a file set "in package" does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0191SKAyPvzEPBA8SgbtYxcK
---
 Sm4shFileExplorer/Sm4shProject.cs | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/Sm4shFileExplorer/Sm4shProject.cs b/Sm4shFileExplorer/Sm4shProject.cs
index 0abf8dd..45b1a0c 100644
--- a/Sm4shFileExplorer/Sm4shProject.cs
+++ b/Sm4shFileExplorer/Sm4shProject.cs
@@ -1170,6 +1170,7 @@ private bool BuildNewResources(ResourceCollection resCol, string[] filesToProces
                     isFolder = true;
                 }
 
+                bool isNew = !resCol.Resources.ContainsKey(relativePath);
                 ResourceItem nItem = GetEditedResource(resCol, relativePath);
 
                 //Force packed
@@ -1182,6 +1183,15 @@ private bool BuildNewResources(ResourceCollection resCol, string[] filesToProces
                     nItem.OffInPack = 1;
                     nItem.IsAPackage = false;
                 }
+                else if (isNew && !isFolder && GetPackedPath(resCol, relativePath.Substring(0, relativePath.LastIndexOf('/') + 1)) != null)
+                {
+                    //A file the game doesn't have, in a folder the game reads as one package: it goes in the
+                    //package. Left as it was (offset 0 = a package of its own), it was written as a loose file
+                    //inside the packaged folder, and the game crashed reading the package (a new character's
+                    //ui/replace/chr/chr_10 icon, user).
+                    nItem.OffInPack = 1;
+                    nItem.IsAPackage = false;
+                }
 
                 //Checking if part of a pack to repack, if yes, lets process it after with PackageProcessor
                 ResourceItem resPacked = GetPackedPath(resCol, relativePath);
