+        /// <summary>
+        /// Remove compression cache entries no build used for COMPRESSION_CACHE_DAYS days
+        /// </summary>
+        private void PruneCompressionCache()
+        {
+            string folder = PathHelper.FolderCache + "compressed" + Path.DirectorySeparatorChar;
+            if (!Directory.Exists(folder))
+                return;
+            DateTime limit = DateTime.UtcNow.AddDays(-COMPRESSION_CACHE_DAYS);
+            foreach (string file in Directory.GetFiles(folder))
