+        private string PackageCacheKey(PackageProcessor package)
+        {
+            try
+            {
+                ResourceCollection resCol = package.TopResource.ResourceCollection;
+                StringBuilder sb = new StringBuilder();
+                sb.Append(PACKAGE_CACHE_VERSION).Append('\n').Append(package.PackedAbsolutePath).Append('\n');
+                sb.Append(GlobalConstants.FORCE_ORIGINAL_COMPRESSION).Append('\n');
+
+                string workspace = PathHelper.GetWorkplaceFolder(PathHelperEnum.FOLDER_PATCH);
+                List<string> mods = new List<string>();
+                foreach (string file in package.FilesToAdd)
