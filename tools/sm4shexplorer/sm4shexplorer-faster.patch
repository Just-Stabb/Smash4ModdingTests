+        /// <summary>
+        /// The game's own stored bytes of a file (zlib-compressed or not, as they are in the DT files or
+        /// the patch's packed file), without decompressing them, so that a package being rebuilt can
+        /// take an untouched file as it is instead of decompressing and compressing it again.
+        /// </summary>
+        /// <returns>false if the file can't be taken as it is (the caller then extracts it as usual)</returns>
+        public bool TryGetStoredData(ResourceItem rItem, out byte[] data, out uint cmpSize, out uint decSize)
+        {
+            data = null;
+            cmpSize = decSize = 0;
+            try
+            {
+                if (rItem.IsFolder || rItem.CmpSize == 0 || rItem.OverridePackedFile)
+                    return false;
+
+                if (rItem.Source == FileSource.LS)
+                {
+                    if (rItem.LSEntryInfo == null)
+                        return false;
+                    FileStream dt;
+                    if (!_DtStreams.TryGetValue(rItem.LSEntryInfo.DTIndex, out dt))
+                    {
+                        dt = new FileStream(_DtPaths[rItem.LSEntryInfo.DTIndex], FileMode.Open, FileAccess.Read, FileShare.ReadWrite);
+                        _DtStreams.Add(rItem.LSEntryInfo.DTIndex, dt);
+                    }
+                    data = new byte[rItem.CmpSize];
+                    dt.Position = (long)rItem.LSEntryInfo.DTOffset + rItem.OffInPack;
+                    int read = 0;
+                    while (read < data.Length)
+                    {
+                        int n = dt.Read(data, read, data.Length - read);
+                        if (n <= 0)
+                            return false;
+                        read += n;
+                    }
+                    cmpSize = rItem.CmpSize;
+                    decSize = rItem.DecSize;
+                }
+                else if (rItem.Source == FileSource.Patch)
+                {
+                    //Files the patch has on their own are copied (and recompressed) as before
+                    string gameFile = PathHelper.GetGameFolder(PathHelperEnum.FOLDER_PATCH) + rItem.PatchItem.AbsolutePath.Replace('/', Path.DirectorySeparatorChar);
+                    if (File.Exists(gameFile))
+                        return false;
+                    DataSource packedSource;
+                    if (!TryGetPatchPackedSource(rItem, out packedSource))
+                        return false;
+                    byte[] checkCmp = packedSource.Slice((int)rItem.OffInPack, 2);
+                    bool compressed = checkCmp[0] == 0x78 && checkCmp[1] == 0x9c;
+                    cmpSize = compressed ? rItem.CmpSize : rItem.DecSize;
+                    decSize = rItem.DecSize;
+                    data = packedSource.Slice((int)rItem.OffInPack, (int)cmpSize);
+                }
+                else
+                    return false;
+
+                //Same cases as the extraction: compressed data starts with 78 9C (and then is smaller),
+                //anything else is stored as it is. Data starting with padding (CC) goes the usual way.
+                if (data.Length < 4 || BitConverter.ToUInt32(data, 0) == 0xCCCCCCCC)
+                    return false;
+                bool isZlib = data[0] == 0x78 && data[1] == 0x9c;
+                if (isZlib != (cmpSize != decSize))
+                    return false;
+                return true;
+            }
+            catch (Exception e)
+            {
+                LogHelper.Debug(string.Format("Can't take '{0}' as stored ({1}), extracting it", rItem.AbsolutePath, e.Message));
+                data = null;
+                return false;
+            }
+        }
+
+        private bool TryGetPatchPackedSource(ResourceItem rItem, out DataSource packedSource)
+        {
+            //If packed file not datasourced yet
+            string packed = rItem.PatchItem.AbsolutePath;
+            if (_CachedDataSources.TryGetValue(packed, out packedSource))
+                return true;
+
+            string gamePackedFile = PathHelper.GetGameFolder(PathHelperEnum.FOLDER_PATCH) + rItem.AbsolutePath.Replace('/', Path.DirectorySeparatorChar);
+            string path = gamePackedFile.Substring(0, gamePackedFile.LastIndexOf("\\data")) + Path.DirectorySeparatorChar + packed.Replace("/", "\\") + "packed";
+            if (!File.Exists(path))
+                return false;
+            packedSource = new DataSource(FileMap.FromFile(path));
+            _CachedDataSources.Add(packed, packedSource);
+            return true;
+        }
+
         public void ClearCachedDataSources()
         {
             foreach (DataSource ds in _CachedDataSources.Values)
                 ds.Close();
             _CachedDataSources = new Dictionary<string, DataSource>();
+            foreach (FileStream dt in _DtStreams.Values)
+                dt.Dispose();
+            _DtStreams = new Dictionary<int, FileStream>();
         }
 
