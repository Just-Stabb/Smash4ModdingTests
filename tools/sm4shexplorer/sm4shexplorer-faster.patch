+        private static byte[] ReadAt(string path, long offset, int size)
+        {
+            using (FileStream fs = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.ReadWrite, 4096))
+            {
+                byte[] data = new byte[size];
+                fs.Position = offset;
+                int read = 0;
+                while (read < size)
+                {
+                    int n = fs.Read(data, read, size - read);
+                    if (n <= 0)
+                        return null;
+                    read += n;
+                }
+                return data;
+            }
+        }
