+                    ResourceItem r;
+                    if (!resCol.Resources.TryGetValue(rel, out r))
+                        continue;
+                    ResourceItem o = r.OriginalResourceItem ?? r;
+                    sb.Append("G ").Append(rel).Append('|').Append(o.Source).Append('|').Append(o.OffInPack).Append('|').Append(o.CmpSize)
+                      .Append('|').Append(o.DecSize).Append('|').Append(o.OverridePackedFile);
+                    if (o.LSEntryInfo != null)
+                        sb.Append('|').Append(o.LSEntryInfo.DTIndex).Append('|').Append(o.LSEntryInfo.DTOffset);
+                    if (o.PatchItem != null)
+                        sb.Append('|').Append(o.PatchItem.AbsolutePath);
+                    sb.Append('\n');
+                }
+                using (SHA1 sha = SHA1.Create())
+                    return BitConverter.ToString(sha.ComputeHash(Encoding.UTF8.GetBytes(sb.ToString()))).Replace("-", string.Empty);
+            }
+            catch (Exception e)
+            {
+                LogHelper.Debug(string.Format("No package cache for '{0}': {1}", package.PackedAbsolutePath, e.Message));
+                return null;
+            }
