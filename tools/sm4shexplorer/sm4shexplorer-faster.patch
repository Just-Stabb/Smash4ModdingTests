+        private const string PACKAGE_CACHE_VERSION = "packages-1";
+        private static string PackageCacheFolder { get { return PathHelper.FolderCache + "packages" + Path.DirectorySeparatorChar; } }
+
+        /// <summary>
+        /// The package's path, its mod files (path, size, content hash) and the game's own files in it
